<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WebViewTestingApp.MainPage">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="10" ColumnSpacing="10">
            <Entry x:Name="UrlEntry" 
                   Grid.Column="0"
                   Placeholder="Zadejte URL adresu"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Přejít" 
                    Clicked="OnNavigateClicked"
                    VerticalOptions="Center" />
        </Grid>
        <WebView x:Name="WebViewControl" 
                 Grid.Row="1" />
    </Grid>
</ContentPage>